# ─────────────────────────────────────────────
# TicketFlow — Backend environment variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ─────────────────────────────────────────────

# ── Supabase / PostgreSQL ─────────────────────
# Get from: Supabase Dashboard → Project Settings → Database → Connection string (Session Pooler)
DATABASE_URL=postgresql://postgres.nvgghebapzhxzrwunwrj:<db-password>@aws-0-nvgghebapzhxzrwunwrj.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://nvgghebapzhxzrwunwrj.supabase.co
SUPABASE_SERVICE_KEY=REDACTED_SUPABASE_JWT
SUPABASE_ANON_KEY=REDACTED_SUPABASE_JWT

# ── Firebase (Admin SDK) ──────────────────────
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Place the downloaded JSON file anywhere on your machine and point to it here
FIREBASE_SERVICE_ACCOUNT_PATH=../ticketflow-firebase.json

# ── Razorpay ─────────────────────────────────
# Get from: Razorpay Dashboard → Settings → API Keys
# Use TEST mode keys for development (prefix: rzp_test_)
RAZORPAY_KEY_ID=rzp_test_REDACTED

RAZORPAY_KEY_SECRET=REDACTED_RAZORPAY_SECRET

# ── Gmail SMTP (for ticket email delivery) ───
# Use a dedicated project Gmail account (not your personal one)
# App Password: myaccount.google.com → Security → 2FA → App Passwords
GMAIL_USER=sweproject07@gmail.com

GMAIL_APP_PASSWORD=rign olpa tcmr numq


# ── App ──────────────────────────────────────
FRONTEND_URL=http://localhost:3000
SECRET_KEY=change-this-to-a-random-secret-in-production
