# Copy to backend/.env and fill in. Never commit the real file.
# Ask a maintainer for the team's test values. Do not paste real keys into issues or PRs.

# development (default) or production. Production refuses to start without the
# required settings, hides /docs and verifies the database certificate.
APP_ENV=development
# Browser origins allowed to call the API, comma separated (https:// only in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (Supabase session pooler, or a local Postgres from docker compose --profile localdb)
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/postgres
# Database TLS: verify (production default), require (development default), disable (local Docker only)
# DATABASE_SSL=require
# CA file for verify, e.g. Supabase's root certificate. Not needed for Azure.
# DATABASE_SSL_ROOT_CERT=

# Supabase storage (verification documents, profile photos)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
VERIFICATION_DOCUMENTS_BUCKET=verification-documents
MAX_DOCUMENT_SIZE_BYTES=10485760

# Firebase Admin: either a path to the service account file or its JSON in one line
FIREBASE_SERVICE_ACCOUNT_PATH=./ticketflow-firebase.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# Razorpay (test mode keys only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Gmail SMTP for ticket and support emails (Google App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Security
ADMIN_INVITE_CODE=
# Inactivity Timeout (seconds: Customer 1800, Manager 1200, Admin 900, Warning 120)
INACTIVITY_TIMEOUT_CUSTOMER_SECONDS=1800
INACTIVITY_TIMEOUT_MANAGER_SECONDS=1200
INACTIVITY_TIMEOUT_ADMIN_SECONDS=900
INACTIVITY_WARNING_LEAD_SECONDS=120
# Required in production. Leave commented out locally: an empty value replaces the built-in default.
# VERIFICATION_SALT_PEPPER=

# AI review summaries (optional)
OPENAI_API_KEY=
OPENAI_REVIEW_MODEL=
# Model for the chat assistant (falls back to OPENAI_REVIEW_MODEL when empty)
OPENAI_CHAT_MODEL=
# Chat assistant model service: openai (default), gemini or ollama
CHAT_PROVIDER=openai
# Overrides the model for any provider (e.g. gemini-3.8-flash); empty = provider default
CHAT_MODEL=
# Needed when CHAT_PROVIDER=gemini (Google AI Studio key); tested model: gemini-3.5-flash-lite
GEMINI_API_KEY=
# Optional: seconds to wait for the model (default 60 for gemini) and Gemini thinking level (default minimal; empty = provider default)
CHAT_TIMEOUT_SECONDS=
CHAT_REASONING_EFFORT=
# Optional: reply token budget for gemini/ollama (default 2048; Gemini counts thinking in it)
CHAT_MAX_TOKENS=
AI_REVIEW_CACHE_DAYS=7
AI_REVIEW_CHUNK_SIZE=40
AI_REVIEW_MAX_REVIEW_CHARS=1500

# Critic review word limits
CRITIC_MIN_WORDS=10
CRITIC_MAX_WORDS=1000

# Rate limiting (all optional, defaults shown)
RATE_LIMIT_ENABLED=true
# true only when the API runs behind a proxy / load balancer, as on Azure (reads the client IP from X-Forwarded-For)
RATE_LIMIT_TRUST_PROXY=false
# Requests per minute for every endpoint: per logged-in user, or per IP when logged out
RATE_LIMIT_GLOBAL_PER_MIN=600
# Requests per minute per IP across all users on it. Keep high (shared campus Wi-Fi); it only stops fake-token floods
RATE_LIMIT_IP_BACKSTOP_PER_MIN=6000

FRONTEND_URL=http://localhost:3000
