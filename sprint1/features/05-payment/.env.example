# Select the integrated team DB when merging Feature 05; use "demo" only for
# the bundled standalone preview. Never commit the real .env file.
PAYMENT_STORAGE=postgres
PAYMENT_PROVIDER=razorpay

# Shared Supabase/PostgreSQL connection string (server-side only).
# Use your Supabase project's direct or session pooler URI; keep password private.
DATABASE_URL=postgresql://postgres:REPLACE_WITH_DATABASE_PASSWORD@db.REPLACE_WITH_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Firebase Admin SDK credentials for server-side Firebase ID token verification.
# Prefer GOOGLE_APPLICATION_CREDENTIALS / workload identity in deployment.
# If using a local service account JSON, set this private path; never commit JSON.
FIREBASE_SERVICE_ACCOUNT_PATH=

# Allow your actual Next.js/React frontend origin(s), comma-separated.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Razorpay Dashboard must be in Test Mode. Live keys are rejected by code.
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_test_key_secret

# Optional integration: the team's frontend can set NEXT_PUBLIC_BACKEND_URL to
# the FastAPI API origin. Do not put any secret in NEXT_PUBLIC_* variables.
