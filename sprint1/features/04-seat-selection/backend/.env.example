# ==============================================================================
# Backend Environment Configuration — Feature 04: Seat Selection & Allocation
# ==============================================================================

# Runtime environment (local | staging | production)
# Safety rule: AUTH_DEV_BYPASS and ENABLE_DEV_PAYMENT_SIMULATOR are only permitted when ENV=local
ENV=local

# Supabase / PostgreSQL direct or transaction pooler connection string.
# When using Supabase transaction pooler (port 6543), the backend code automatically
# configures asyncpg with statement_cache_size=0 as required.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Allowed CORS origins (comma-separated, without trailing slashes)
# In production, specify exact client domains.
ALLOWED_ORIGINS=http://localhost:3000,https://show-booking-system.vercel.app

# Seat allocation business rule caps
MAX_SEATS_PER_BOOKING=8

# Seat lock / hold duration in minutes (NFR: minimum 5 minutes)
SEAT_LOCK_MINUTES=5

# Payment hold window in minutes for checkout transition
PAYMENT_HOLD_MINUTES=10

# Firebase Admin SDK credentials for verifying Bearer ID tokens.
# Token is verified server-side, mapping firebase_uid to internal users.id (UUID).
# In production, provide project ID, client email, and private key.
FIREBASE_PROJECT_ID=show-ticket-booking-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@show-ticket-booking-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# DEV ONLY: Set to true ONLY when ENV=local to bypass Firebase auth verification during local testing.
# When active, accepts 'Authorization: Bearer dev-user-token' and maps to a test UUID.
# The server will refuse to start if AUTH_DEV_BYPASS=true and ENV != local.
AUTH_DEV_BYPASS=true

# DEV ONLY: Mount the local payment confirmation simulator endpoint (/api/dev/simulate-payment/{bookingId}).
# The server will refuse to register this endpoint if ENV != local.
ENABLE_DEV_PAYMENT_SIMULATOR=true
