# ==============================================================================
# Frontend Environment Configuration — Feature 04: Seat Selection & Allocation
# ==============================================================================

# Backend FastAPI URL (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Firebase Client SDK Configuration (public credentials for browser auth)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyFakeDevKeyForLocalExecution12345
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=show-ticket-booking-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=show-ticket-booking-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=show-ticket-booking-dev.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# Navigation destination upon successful seat hold
NEXT_PUBLIC_CHECKOUT_PATH_TEMPLATE=/checkout/{bookingId}

# Local Testing Payment Simulator route toggle
NEXT_PUBLIC_ENABLE_DEV_PAYMENT_SIMULATOR=true
