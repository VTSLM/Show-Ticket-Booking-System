# Customer seat-selection PostgreSQL / Supabase connection
ENV=local
DATABASE_URL=
ALLOWED_ORIGINS=http://localhost:3000
MAX_SEATS_PER_BOOKING=8
SEAT_LOCK_MINUTES=5
PAYMENT_HOLD_MINUTES=10

# Firebase Admin authentication (optional for local demo; configure for real auth)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
AUTH_DEV_BYPASS=false
ENABLE_DEV_PAYMENT_SIMULATOR=false

# Manager layout API uses the Supabase REST client.
# Keep the service-role key backend-only; never put it in frontend env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
