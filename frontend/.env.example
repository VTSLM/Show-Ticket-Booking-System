# ─────────────────────────────────────────────
# TicketFlow — Frontend environment variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git
# ─────────────────────────────────────────────

# ── Backend API ───────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Razorpay (public key only — safe to expose) ─
# Must match the RAZORPAY_KEY_ID in sprint1_v2/backend/.env
# Get from: Razorpay Dashboard → Settings → API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# ── Firebase (web app config — public values) ─
# Get from: Firebase Console → Project Settings → Your Apps → Web app → Config
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
